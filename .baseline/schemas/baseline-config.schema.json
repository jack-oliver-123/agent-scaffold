{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-scaffold/baseline-config.schema.json",
  "title": "Agent Development Baseline configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineVersion",
    "defaultProfile",
    "sourceRepository",
    "sourceCommit",
    "agents",
    "skills"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "baselineVersion": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$" },
    "defaultProfile": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "sourceRepository": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "minLength": 1 },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "defaultSelected",
          "skillsDirectory",
          "ownedPaths"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "defaultSelected": { "type": "boolean" },
          "skillsDirectory": { "type": "string", "minLength": 1 },
          "ownedPaths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "agents"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "source": {
            "type": "object",
            "required": ["kind", "path"],
            "properties": {
              "kind": { "enum": ["upstream", "baseline-owned", "agent-specific"] },
              "path": { "type": "string", "minLength": 1 },
              "license": { "type": "string" },
              "licenseUrl": { "type": "string", "format": "uri" }
            }
          },
          "agents": {
            "type": "array",
            "items": { "enum": ["codex", "claude"] },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
