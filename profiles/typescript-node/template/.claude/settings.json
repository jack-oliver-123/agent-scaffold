{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(corepack pnpm install)",
      "Bash(corepack pnpm check)",
      "Bash(corepack pnpm lint)",
      "Bash(corepack pnpm typecheck)",
      "Bash(corepack pnpm test:*)",
      "Bash(corepack pnpm build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(corepack pnpm publish:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  }
}
