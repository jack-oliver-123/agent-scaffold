{
  "name": "create-agent-scaffold",
  "version": "0.2.0",
  "description": "Interactively create a coding-agent-ready project.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jack-oliver-123/agent-scaffold.git",
    "directory": "packages/create-agent-scaffold"
  },
  "homepage": "https://github.com/jack-oliver-123/agent-scaffold#readme",
  "bugs": {
    "url": "https://github.com/jack-oliver-123/agent-scaffold/issues"
  },
  "bin": {
    "create-agent-scaffold": "dist/cli.js"
  },
  "files": ["dist", "payload"],
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "build:payload": "node scripts/build-payload.mjs",
    "test:packed": "node scripts/test-packed.mjs",
    "prepack": "corepack pnpm build && corepack pnpm build:payload"
  },
  "dependencies": {
    "@inquirer/prompts": "8.5.2"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
